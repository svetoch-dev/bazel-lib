module(name = "svetoch_bazel_lib")

###########
# Bazel
###########
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

bazel_dep(name = "buildifier_prebuilt", version = "10.1.0")
bazel_dep(name = "aspect_bazel_lib", version = "2.22.5")

bazel_lib_toolchains = use_extension("@aspect_bazel_lib//lib:extensions.bzl", "toolchains")
use_repo(bazel_lib_toolchains, "zstd_toolchains")

bazel_dep(name = "rules_multirun", version = "0.14.0")

######################
# Binary tools support
######################
bazel_dep(name = "rules_bin_tools")
git_override(
    module_name = "rules_bin_tools",
    commit = "d3fefc59031fe28fcc41918f8e9df752c58c3c49",
    remote = "https://github.com/ggramal/rules_bin_tools",
)

tools = use_extension("@rules_bin_tools//tools:extensions.bzl", "tools")
tools.download(
    helm_version = "v4.3.0",
    suffix = "exec",
)
use_repo(tools, "helm_exec")

######################
# Terraform support
######################

bazel_dep(name = "rules_tf")
git_override(
    module_name = "rules_tf",
    commit = "841d00ec6a9d619e278c6adf37b343bda7f1a554",
    remote = "https://github.com/ggramal/rules_tf",
)

tf = use_extension("@rules_tf//tf:extensions.bzl", "tf")
tf.toolchain(
    name = "svetoch_bazel_lib_tf_executable",
    version = "1.14.4",
)
use_repo(tf, "svetoch_bazel_lib_tf_executable")

register_toolchains(
    "@svetoch_bazel_lib_tf_executable//:all",
)

load_file = use_extension("@svetoch_bazel_lib//tools:extensions.bzl", "load_file")
load_file.json(
    name = "svetoch_bazel_lib_tfvars",
    src = "@svetoch_bazel_lib//:terraform.tfvars.json",
    variable_name = "tfvars",
)
use_repo(load_file, "svetoch_bazel_lib_tfvars")

###################
# Container support
###################

bazel_dep(name = "rules_oci", version = "2.3.0")
bazel_dep(name = "rules_distroless", version = "0.9.4")

oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")
oci.pull(
    name = "svetoch_bazel_lib_argocd",
    #v3.5.6
    digest = "sha256:c5d9da82a891a0ca5998a8665ced65c14f2523ddfabe62ce44e508d0cb661d4e",
    image = "quay.io/argoproj/argocd",
    platforms = [
        "linux/amd64",
    ],
)
oci.pull(
    name = "svetoch_bazel_lib_postgres-exporter",
    #v0.18.1
    digest = "sha256:fb96c4413985d4b23ab02b19022b3d70a86c8e0a62f41ab15ebb6f4673781a5d",
    image = "quay.io/prometheuscommunity/postgres-exporter",
    platforms = [
        "linux/amd64",
        "linux/arm64",
    ],
)
oci.pull(
    name = "svetoch_bazel_lib_spilo17",
    #spilo-17:4.0-p3
    digest = "sha256:17bf371c924196e4671f19d129fa86a80f7dcea7b2666cedca955ec0fba0b72b",
    image = "ghcr.io/zalando/spilo-17",
    platforms = [
        "linux/amd64",
    ],
)
use_repo(
    oci,
    "svetoch_bazel_lib_argocd",
    "svetoch_bazel_lib_argocd_linux_amd64",
    "svetoch_bazel_lib_postgres-exporter",
    "svetoch_bazel_lib_postgres-exporter_linux_amd64",
    "svetoch_bazel_lib_postgres-exporter_linux_arm64",
    "svetoch_bazel_lib_spilo17",
    "svetoch_bazel_lib_spilo17_linux_amd64",
)

apt = use_extension("@rules_distroless//apt:extensions.bzl", "apt")
apt.sources_list(
    architectures = ["amd64"],
    components = ["main"],
    suites = [
        "trixie",
        "trixie-updates",
    ],
    types = ["deb"],
    uris = [
        "https://snapshot.debian.org/archive/debian/20261026T022331Z",
        "https://snapshot-cloudflare.debian.org/archive/debian/20261026T022331Z",
    ],
)
apt.sources_list(
    architectures = ["amd64"],
    components = ["main"],
    suites = ["trixie-security"],
    types = ["deb"],
    uris = [
        "https://snapshot.debian.org/archive/debian-security/20261026T044319Z",
        "https://snapshot-cloudflare.debian.org/archive/debian-security/20261026T044319Z",
    ],
)
apt.install(
    dependency_set = "svetoch_bazel_lib_trixie",
    packages = [
        # buildifier: disable=unsorted-list
        # base image
        "ncurses-base",
        "libncurses6",
        "tzdata",
        "bash",
        "coreutils",  # for commands like `ls`
        "grep",
        # for apt list --installed
        "dpkg",
        "apt",
        "perl",
        "sed",  # needed by py_binary rules
        "mawk",  # needed by py_binary rules + mtree_mutate + rules_distroless.flatten
        # bazelisk deps
        "git",  # used in scripts/ci/ci.sh
        "curl",  # used in scripts/ci/ci.sh
        "gzip",  # used in scripts/ci/ci.sh
        "libc6-dev",  # assert.h, stdlib.h etc used by dpkg_status to compile packages
        "g++",  # used by dpkg_status to compile packages
        "libc-bin",  # contains getent CLI needed by rules_tf to look up HOME if it is not set
        "gcc",  # needed by bazel
        "findutils",  # needed for requirements.txt.lock tests
        "python3",  # needed for requirements.txt.lock tests
    ],
)
use_repo(apt, "svetoch_bazel_lib_trixie")

http_archive(
    name = "svetoch_bazel_lib_ca_certificates",
    build_file_content = "exports_files([\"data.tar.xz\"])",
    sha256 = "14a35850411e3a26ac4802638ccafe437dae4c79a1d10b3a264d1a404a286305",
    type = ".deb",
    urls = ["https://snapshot.debian.org/archive/debian/20261020T202723Z/pool/main/c/ca-certificates/ca-certificates_20260816%2Bnmu1_all.deb"],
)

http_file(
    name = "svetoch_bazel_lib_bazelisk",
    downloaded_file_path = "bazelisk",
    sha256 = "a248ae2b2b62b5baebb748f6fba7203bff1a27e5d01b55399a8406744cb539e8",
    url = "https://github.com/bazelbuild/bazelisk/releases/download/v1.30.0/bazelisk-linux-amd64",
)

http_file(
    name = "svetoch_bazel_lib_yc_cli",
    downloaded_file_path = "yc",
    sha256 = "19202356b0ad3b6d9199202936619605d6069e84df2fb86c56030bccd4c981b5",
    url = "https://storage.yandexcloud.net/yandexcloud-yc/release/1.42.0/linux/amd64/yc",
)

http_archive(
    name = "svetoch_bazel_lib_docker_credential_gcr",
    build_file_content = "exports_files([\"docker-credential-gcr\"])",
    sha256 = "54733a03c18f230059d89e8976518de9af16cebb74b86ccab5c95c9da66f5912",
    urls = ["https://github.com/GoogleCloudPlatform/docker-credential-gcr/releases/download/v2.2.1/docker-credential-gcr_linux_amd64-2.2.1.tar.gz"],
)

##################
# Python support
##################
bazel_dep(name = "aspect_rules_py", version = "2.0.0-alpha.10")
bazel_dep(name = "rules_python", version = "2.4.5")

rules_python_config = use_extension("@rules_python//python/extensions:config.bzl", "config")
rules_python_config.explicit_init_py(default = True)

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.defaults(python_version = "3.11")
python.toolchain(
    python_version = "3.11",
)
use_repo(python, python = "python_versions")

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "svetoch_bazel_lib_py_deps",
    python_version = "3.11",
    requirements_lock = "@svetoch_bazel_lib//deps/py:requirements_lock_3_11.txt",
)
use_repo(pip, "svetoch_bazel_lib_py_deps")
