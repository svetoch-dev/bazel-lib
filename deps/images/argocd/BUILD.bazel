load("@rules_oci//oci:defs.bzl", "oci_image")
load("@tar.bzl", "mtree_mutate", "mtree_spec", "tar")

mtree_spec(
    name = "mtree_yc",
    srcs = ["@svetoch_bazel_lib_yc_cli//file"],
)

mtree_mutate(
    name = "install_yc",
    mtree = ":mtree_yc",
    package_dir = "usr/local/bin",
)

tar(
    name = "yc",
    srcs = ["@svetoch_bazel_lib_yc_cli//file"],
    mtree = ":install_yc",
)

tar(
    name = "yc_link",
    mtree = [
        "./usr/local/bin/yc type=link link=/usr/local/bin/file/yc",
    ],
)

tar(
    name = "token",
    srcs = ["token.sh"],
    mtree = [
        "./token.sh type=file mode=0755 uid=0 gid=0 content=$(execpath token.sh)",
    ],
)

oci_image(
    name = "argocd_img",
    base = "@svetoch_bazel_lib_argocd",
    tars = [
        ":token",
        ":yc",
        ":yc_link",
    ],
    visibility = ["//visibility:public"],
)
