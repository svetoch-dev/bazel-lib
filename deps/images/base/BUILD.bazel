load("@aspect_bazel_lib//lib:tar.bzl", "tar")
load("@rules_distroless//distroless:defs.bzl", "cacerts", "group", "passwd")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("@svetoch_bazel_lib//tools/macros:deb_packages.bzl", "deb_packages")

cacerts(
    name = "ca",
    package = "@svetoch_bazel_lib_ca_certificates//:data.tar.xz",
)

passwd(
    name = "passwd",
    entries = [
        {
            "uid": 0,
            "gid": 0,
            "home": "/root",
            "shell": "/bin/bash",
            "username": "root",
        },
        {
            "uid": 100,
            "gid": 65534,
            "home": "/home/_apt",
            "shell": "/usr/sbin/nologin",
            "username": "_apt",
        },
        {
            "uid": 1000,
            "gid": 1000,
            "home": "/home/debian",
            "shell": "/bin/bash",
            "username": "debian",
        },
    ],
)

group(
    name = "group",
    entries = [
        {
            "name": "root",
            "gid": 0,
        },
        {
            "name": "_apt",
            "gid": 65534,
        },
        {
            "name": "debian",
            "gid": 1000,
        },
    ],
)

tar(
    name = "sh_homedir",
    mtree = [
        # needed as dpkg assumes sh is installed in a typical debian installation.
        "./usr/bin/sh type=link link=/usr/bin/bash",
        "./home/debian/ uid=1000 gid=0 mode=0755 type=dir",
        #symlink awk to mawk the same how its done in ubuntu
        "./usr/bin/awk type=link link=/usr/bin/mawk",
    ],
)

PACKAGES = [
    "@svetoch_bazel_lib_trixie//ncurses-base",
    "@svetoch_bazel_lib_trixie//libncurses6",
    "@svetoch_bazel_lib_trixie//tzdata",
    "@svetoch_bazel_lib_trixie//bash",
    "@svetoch_bazel_lib_trixie//coreutils",
    "@svetoch_bazel_lib_trixie//dpkg",
    "@svetoch_bazel_lib_trixie//grep",
    "@svetoch_bazel_lib_trixie//apt",
    "@svetoch_bazel_lib_trixie//perl",
    "@svetoch_bazel_lib_trixie//sed",
    "@svetoch_bazel_lib_trixie//mawk",
]

_packages_tar = deb_packages(PACKAGES)

oci_image(
    name = "debian_trixie",
    architecture = "amd64",
    entrypoint = ["/bin/bash"],
    env = {
        "SSL_CERT_FILE": "/etc/ssl/certs/ca-certificates.crt",
    },
    os = "linux",
    tars = [
        ":sh_homedir",
        ":passwd",
        ":group",
        ":ca",
        _packages_tar,
    ],
    visibility = ["//visibility:public"],
)

#bazel run :debian_trixie_tarball
#docker run --rm -it debian_trixie:latest
oci_load(
    name = "debian_trixie_tarball",
    image = ":debian_trixie",
    repo_tags = [
        "debian_trixie:latest",
    ],
)
