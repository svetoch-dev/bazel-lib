load("@aspect_bazel_lib//lib:tar.bzl", "mtree_mutate", "mtree_spec", "tar")
load("@rules_distroless//distroless:defs.bzl", "passwd")
load("@rules_oci//oci:defs.bzl", "oci_image")
load("@svetoch_bazel_lib//tools/macros:deb_packages.bzl", "deb_packages")

#github actions runner uses a user with uid=1001 https://github.com/actions/runner-images/issues/10936
#because of this there is a permission missmatch  running in a container where user
#has uid=1000
passwd(
    name = "passwd",
    entries = [
        {
            "uid": 0,
            "gid": 0,
            "home": "/root",
            "shell": "/bin/bash",
            "username": "root",
        },
        {
            "uid": 100,
            "gid": 65534,
            "home": "/home/_apt",
            "shell": "/usr/sbin/nologin",
            "username": "_apt",
        },
        {
            "uid": 1001,
            "gid": 1000,
            "home": "/home/ubuntu",
            "shell": "/bin/bash",
            "username": "ubuntu",
        },
    ],
)

PACKAGES = [
    "@svetoch_bazel_lib_noble//git",
    "@svetoch_bazel_lib_noble//curl",
    "@svetoch_bazel_lib_noble//sed",
    "@svetoch_bazel_lib_noble//mawk",
    "@svetoch_bazel_lib_noble//gcc",
    "@svetoch_bazel_lib_noble//findutils",
    "@svetoch_bazel_lib_noble//python3",
    "@svetoch_bazel_lib_noble//gzip",
    "@svetoch_bazel_lib_noble//libc-bin",
    "@svetoch_bazel_lib_noble//libc6-dev",
    "@svetoch_bazel_lib_noble//g++",
]

_packages_tar = deb_packages(PACKAGES)

mtree_spec(
    name = "mtree_bazelisk",
    srcs = ["@svetoch_bazel_lib_bazelisk//file"],
)

mtree_mutate(
    name = "change_owner_bazelisk",
    mtree = "@svetoch_bazel_lib//deps/images/bazelisk:mtree_bazelisk",
    owner = "1001",
    package_dir = "usr/local/bin",
)

tar(
    name = "bazelisk",
    srcs = ["@svetoch_bazel_lib_bazelisk//file"],
    mtree = "@svetoch_bazel_lib//deps/images/bazelisk:change_owner_bazelisk",
)

tar(
    name = "links",
    mtree = [
        #Some bug with mtree_mutate with strip_prefix = "file"
        #so we need to use a symlink here
        "./usr/local/bin/bazel type=link link=/usr/local/bin/file/bazelisk",
        #symlink awk to mawk the same how its done in ubuntu
        "./usr/bin/awk type=link link=/usr/bin/mawk",
        #change permissions of home dir
        "./home/ubuntu/ uid=1001 gid=0 mode=0755 type=dir",
    ],
)

oci_image(
    name = "bazelisk_img",
    base = "@svetoch_bazel_lib//deps/images/base:ubuntu_noble",
    visibility = ["//visibility:public"],
    tars = [
        _packages_tar,
        "@svetoch_bazel_lib//deps/images/bazelisk:passwd",
        "@svetoch_bazel_lib//deps/images/bazelisk:bazelisk",
        "@svetoch_bazel_lib//deps/images/bazelisk:links",
    ],
    user = "1001",
)
