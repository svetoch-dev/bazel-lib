load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("@svetoch_bazel_lib//tools/lint/py:black.bzl", "py_lint")
load("@svetoch_bazel_lib_py_deps//:requirements.bzl", "requirement")

py_lint()

py_library(
    name = "k8s",
    srcs = glob(
        ["*.py"],
        exclude = ["test*py"],
    ),
    visibility = ["//visibility:public"],
    deps = [
        "@svetoch_bazel_lib//rod/libs/py/yc:k8s",
        "@svetoch_bazel_lib//rod/libs/py/yc:client",
        "@svetoch_bazel_lib//rod/libs/py/gcp:gke",
        "@svetoch_bazel_lib//rod/libs/py/gcp:auth",
        "@svetoch_bazel_lib//rod/libs/py/settings",
        "@svetoch_bazel_lib//rod/libs/py/tf",
        requirement("kubernetes"),
        requirement("pydantic"),
    ],
)

py_test(
    name = "tests",
    srcs = ["test_config.py"],
    main = "test_config.py",
    deps = [
        ":k8s",
        requirement("pydantic"),
    ],
)
