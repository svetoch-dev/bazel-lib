load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("@svetoch_bazel_lib//tools/lint/py:black.bzl", "py_lint")
load("@svetoch_bazel_lib_py_deps//:requirements.bzl", "requirement")

py_lint()

py_library(
    name = "tf",
    srcs = glob(
        ["*.py"],
        exclude = ["test*py"],
    ),
    visibility = ["//visibility:public"],
    deps = [
        "@svetoch_bazel_lib//rod/libs/py/helpers",
        "@svetoch_bazel_lib//rod/libs/py/settings",
        "@svetoch_bazel_lib//rod/libs/py/utils",
        "@svetoch_bazel_lib//rod/libs/py/yc:client",
        requirement("google-cloud-storage"),
        requirement("grpcio"),
        requirement("protobuf"),
        requirement("pydantic"),
        requirement("yandexcloud"),
    ],
)

py_test(
    name = "tests",
    srcs = glob(
        ["*.py"],
    ),
    data = [
        "//:terraform.tfvars.json",
    ],
    deps = [
        "@svetoch_bazel_lib//rod/libs/py/helpers",
        "@svetoch_bazel_lib//rod/libs/py/settings",
        "@svetoch_bazel_lib//rod/libs/py/utils",
        "@svetoch_bazel_lib//rod/libs/py/yc:client",
        requirement("google-cloud-storage"),
        requirement("grpcio"),
        requirement("protobuf"),
        requirement("pydantic"),
        requirement("yandexcloud"),
    ],
)
