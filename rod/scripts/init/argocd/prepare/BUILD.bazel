    deps = [
        "@svetoch_bazel_lib//rod/libs/py/k8s",
        "@svetoch_bazel_lib//rod/libs/py/tf",
        "@svetoch_bazel_lib//rod/libs/py/utils",
        "@svetoch_bazel_lib//rod/libs/py/helpers",
        requirement("GitPython"),
    ],
