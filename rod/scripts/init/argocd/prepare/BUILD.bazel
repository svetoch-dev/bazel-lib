load("@aspect_rules_py//py:defs.bzl", "py_binary")
load("@svetoch_bazel_lib//tools/lint/py:black.bzl", "py_lint")
load("@svetoch_bazel_lib_py_deps//:requirements.bzl", "requirement")

py_lint()

py_binary(
    name = "prepare_argocd",
    srcs = ["prepare_argocd.py"],
    data = [
        "@helm_exec//:executable",
    ],
    env = {
        "HELM_EXECUTABLE": "$(rootpath @helm_exec//:executable)",
    },
    visibility = ["//visibility:public"],
    deps = [
        "@svetoch_bazel_lib//rod/libs/py/helpers",
        "@svetoch_bazel_lib//rod/libs/py/k8s",
        "@svetoch_bazel_lib//rod/libs/py/settings",
        "@svetoch_bazel_lib//rod/libs/py/tf",
        "@svetoch_bazel_lib//rod/libs/py/utils",
        requirement("GitPython"),
    ],
)

py_binary(
    name = "copy",
    srcs = [
        "copy.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "@svetoch_bazel_lib//rod/libs/py/settings",
        "@svetoch_bazel_lib//rod/libs/py/tf",
        "@svetoch_bazel_lib//rod/libs/py/utils",
    ],
)


