load("@aspect_rules_py//py:defs.bzl", "py_binary", "py_test")
load("@svetoch_bazel_lib//tools/lint/py:black.bzl", "py_lint")
load("@svetoch_bazel_lib_py_deps//:requirements.bzl", "requirement")

py_lint()

py_binary(
    name = "update_tfvars",
    srcs = ["update_tfvars.py"],
    visibility = ["//visibility:public"],
    deps = [
        "@svetoch_bazel_lib//rod/libs/py/settings",
        "@svetoch_bazel_lib//rod/libs/py/tf",
        "@svetoch_bazel_lib//rod/libs/py/utils",
        "@svetoch_bazel_lib//rod/libs/py/yc:registry",
    ],
)

py_binary(
    name = "update_kube_config",
    srcs = ["update_kube_config.py"],
    visibility = ["//visibility:public"],
    deps = [
        "@svetoch_bazel_lib//rod/libs/py/k8s",
        "@svetoch_bazel_lib//rod/libs/py/k8s:exceptions",
        "@svetoch_bazel_lib//rod/libs/py/settings",
        "@svetoch_bazel_lib//rod/libs/py/tf",
        "@svetoch_bazel_lib//rod/libs/py/utils",
        "@svetoch_bazel_lib//rod/libs/py/helpers",
        requirement("PyYaml"),
    ],
)

py_test(
    name = "tests",
    srcs = glob(
        ["*.py"],
    ),
    deps = [
        "@svetoch_bazel_lib//rod/libs/py/k8s",
        "@svetoch_bazel_lib//rod/libs/py/settings",
        "@svetoch_bazel_lib//rod/libs/py/tf",
        "@svetoch_bazel_lib//rod/libs/py/utils",
        "@svetoch_bazel_lib//rod/libs/py/yc:registry",
        requirement("PyYaml"),
        requirement("pydantic"),
    ],
)
